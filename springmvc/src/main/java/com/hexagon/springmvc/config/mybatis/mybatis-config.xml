		<typeAlias type="com.hexagon.springmvc.domain.Emp" 				 alias="Emp"/>
		<typeAlias type="com.hexagon.springmvc.domain.Bio" 				 alias="Bio"/>
		<typeAlias type="com.hexagon.springmvc.domain.Admin" 			 alias="Admin"/>
		<typeAlias type="com.hexagon.springmvc.domain.TopCategory" 			 alias="TopCategory"/>
		<typeAlias type="com.hexagon.springmvc.domain.SubCategory" 			 alias="SubCategory"/>
		<typeAlias type="com.hexagon.springmvc.domain.News" 			 alias="News"/>
	</typeAliases>
	
</configuration>
